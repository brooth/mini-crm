{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "vite: dev",
      "type": "shell",
      // npm comes from nvm, which is lazy-loaded only in interactive shells
      "command": "source \"${env:HOME}/.nvm/nvm.sh\" && nvm use && npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^x{0}$" },
        "background": {
          "activeBegin": "VITE v",
          "endsPattern": "Local:\\s+http"
        }
      }
    }
  ]
}
